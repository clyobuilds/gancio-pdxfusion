{
  "name": "gancio",
  "version": "2.0.0-beta.5",
  "description": "A shared agenda for local communities",
  "author": "lesion",
  "bugs": {
    "email": "lesion@autistici.org",
    "url": "https://framagit.org/les/gancio/issues"
  },
  "homepage": "https://gancio.org",
  "keywords": [
    "AP",
    "gancio",
    "events",
    "federation",
    "activitypub",
    "event",
    "server",
    "self-host",
    "app"
  ],
  "tsup": {
    "entry": [
      "server/cli/index.ts"
    ],
    "outDir": ".cli",
    "format": "esm",
    "target": "esnext",
    "sourcemap": false,
    "minify": true,
    "bundle": true,
    "clean": true,
    "splitting": false,
    "external": [
      "dotenv"
    ],
    "env": {
      "NODE_ENV": "production"
    },
    "banner": {
      "js": "#!/usr/bin/env node"
    }
  },
  "bin": "./server/gancio",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://framagit.org/les/gancio"
  },
  "type": "module",
  "scripts": {
    "cli": "tsx --tsconfig server/tsconfig.json server/cli",
    "build": "nuxi build",
    "build:cli": "tsup",
    "build:wc": "cd webcomponents; pnpm run build:lib; cp dist/* ../wp-plugin/js/; cp dist/* ../public/; cp dist/* ../docs/assets/js/;",
    "dev": "NODE_OPTIONS='--trace-warnings' nuxi dev",
    "postinstall": "nuxi prepare || true",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "test:mariadb": "export GANCIO_DB_DIALECT=mariadb && vitest run",
    "test:postgres": "export GANCIO_DB_DIALECT=postgres && vitest run",
    "test:dev": "vitest dev",
    "test:ui": "TZ=UTC vitest --ui --open",
    "migrate": "NODE_ENV=production sequelize db:migrate",
    "migrate:dev": "sequelize db:migrate",
    "analyze": "nuxt build --analyze",
    "check:circular": "madge --circular --extensions ts,js,vue --ts-config server/tsconfig.madge.json server",
    "check:i18n": "i18n-check -s en --locales i18n/locales -f i18next --only invalidKeys",
    "prepare": "husky || true",
    "docs:dev": "./scripts/docs.sh dev",
    "docs:build": "./scripts/docs.sh build",
    "docs:preview": "vitepress preview docs",
    "build:dev": "./scripts/build.sh -d",
    "build:prod": "./scripts/build.sh -p",
    "pack:dev": "npm run build:dev && npm pack .pack",
    "pack:prod": "npm run build:prod  && npm pack"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/mariadb": "^7.0.0-alpha.47",
    "@sequelize/postgres": "^7.0.0-alpha.47",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "consola": "^3.4.2",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "email-templates": "^13.0.1",
    "fast-xml-parser": "^5.11.2",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.2.1",
    "ics": "^3.8.1",
    "jose": "^6.2.12",
    "jsdom": "^29.1.1",
    "jsonld": "^9.0.0",
    "linkify-html": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash.intersection": "^4.4.0",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "mitt": "^3.0.1",
    "negotiator": "^1.1.0",
    "nuxt": "^4.5.2",
    "pug": "^3.0.3",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "v-calendar": "^3.1.2",
    "vue": "3.5.43",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingual/i18n-check": "^0.9.5",
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/sitemap": "8.6.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/email-templates": "^10.0.4",
    "@types/jsonld": "^1.5.15",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.6",
    "@types/mime-types": "^3.0.1",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.3",
    "@types/pug": "^2.0.10",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools-core": "^8.2.1",
    "@vue/devtools-kit": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "cheerio": "^1.2.0",
    "commit-and-tag-version": "^13.2.1",
    "defu": "^6.1.7",
    "eslint": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "feed": "^6.0.0",
    "h3": "^1.15.4",
    "handlebars": "^4.7.9",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsdoc-api": "^9.3.5",
    "json-canonicalize": "^3.0.1",
    "leaflet": "^1.9.4",
    "lint-staged": "^17.6.0",
    "lodash": "^4.17.21",
    "madge": "^8.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "material-design-icons-iconfont": "^6.7.0",
    "nitro-test-utils": "^0.11.2",
    "nitropack": "^2.13.0",
    "npm-packlist": "^11.0.0",
    "ofetch": "^1.5.1",
    "playwright-core": "^1.60.0",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-openapi": "^0.2.5",
    "vitest": "^5.0.3",
    "vue-screen-utils": "^1.0.0-beta.13",
    "vuetify": "^3.12.0"
  },
  "packageManager": "pnpm@11.5.2",
  "date": "06 July 2026"
}
